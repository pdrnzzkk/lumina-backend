# Copie para .env e preencha. NUNCA commite o .env.
APP_NAME=Lumina API
APP_ENV=development
DEBUG=true

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE no backend, nunca no app Flutter
SUPABASE_SERVICE_ROLE_KEY=

# Claude (Anthropic) - geração e calibração de questões
ANTHROPIC_API_KEY=

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
